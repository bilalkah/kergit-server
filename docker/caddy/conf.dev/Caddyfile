{
  servers :443 {
    protocols h1 h2
  }
}

(livekit_cors_headers) {
  Access-Control-Allow-Origin "{http.request.header.Origin}"
  Access-Control-Allow-Credentials "true"
  Access-Control-Allow-Methods "GET, OPTIONS"
  Access-Control-Allow-Headers "Authorization, Content-Type"
  Vary "Origin"
}

(browser_origin_allowed) {
  expression `{header.Origin} == "{$WEB_DOMAIN}"`
}

(frontend_security_headers) {
  Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  X-Frame-Options "DENY"
  Referrer-Policy "strict-origin-when-cross-origin"
  Permissions-Policy "geolocation=(), camera=(self), microphone=(self), usb=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=()"
  Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src 'self'; form-action 'self' {$NUXT_PUBLIC_SUPABASE_URL}; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.dicebear.com {$NUXT_PUBLIC_SUPABASE_URL}; connect-src 'self' {$NUXT_PUBLIC_SUPABASE_URL} {$WEB_SOCKET_ORIGIN}; worker-src 'self' blob:; media-src 'self' blob:"
}

(livekit_gateway) {
  @allowedOrigin {
    import browser_origin_allowed
  }

  @originPresent header Origin *

  handle @allowedOrigin {
    header {
      import livekit_cors_headers
    }
    reverse_proxy {args[0]}
  }

  handle @originPresent {
    respond 403
  }

  reverse_proxy {args[0]}
}

{$WEB_DOMAIN} {

  tls {$CADDY_TLS_CERT_FILE:/certs/dev/localhost.pem} {$CADDY_TLS_KEY_FILE:/certs/dev/localhost-key.pem}


  # -----------------------
  # CORS preflight handling
  # -----------------------

  @livekitAllowedPreflight {
    path /livekit*
    method OPTIONS
    import browser_origin_allowed
  }

  handle @livekitAllowedPreflight {
    header {
      import livekit_cors_headers
    }
    respond "" 204
  }

  @livekitPreflight {
    path /livekit*
    method OPTIONS
  }
  respond @livekitPreflight 403

  @globalOptions method OPTIONS
  respond @globalOptions 204


  # -----------------------
  # Admin protection
  # -----------------------

  @adminDenied {
    path /admin* /admin-api* /admin-livekit-metrics*
    not client_ip {$ADMIN_ALLOWED_CIDR:127.0.0.1/32}
  }
  handle @adminDenied {
    respond 403
  }


  # -----------------------
  # Admin services
  # -----------------------

  handle_path /admin-api* {
    reverse_proxy {$ADMIN_CONTROL_TARGET:server-node:8081}
  }

  import /etc/caddy-generated/livekit_routes.caddy

  handle /admin* {
    reverse_proxy {$ADMIN_APP_TARGET:admin-node:3001}
  }


  # -----------------------
  # Realtime services
  # -----------------------

  handle_path /ws* {
    reverse_proxy {$CADDY_WS_TARGET:server-node:9001} {
      header_up Host {host}
      header_up Origin {http.request.header.Origin}
      header_up X-Forwarded-Origin {http.request.header.Origin}
    }
  }


  # -----------------------
  # Web frontend
  # -----------------------

  handle {
    reverse_proxy {$CADDY_WEB_TARGET:web-node:3000}
    header {
      import frontend_security_headers
    }
  }
}
